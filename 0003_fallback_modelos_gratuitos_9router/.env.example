# ==============================================================================
# 9Router Claude Code sem Limites com Arsenal de Modelos Gratuitos e Fallback
# ==============================================================================

# Servidor 9Router
PORT=20128
HOSTNAME=0.0.0.0
NODE_ENV=production
DATA_DIR=/app/data
NEXT_PUBLIC_BASE_URL=http://localhost:20128

# Seguranca e Acesso Local
# Gere uma com: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
INITIAL_PASSWORD=coloque_aqui_sua_senha
# Use um valor longo e aleatorio, gerado do mesmo jeito.
JWT_SECRET=coloque_aqui_seu_jwt_secret
REQUIRE_API_KEY=false
REQUIRE_LOGIN=false

# Integracao com Claude Code (Aponte para o gateway local sem /v1)
ANTHROPIC_BASE_URL=http://localhost:20128
# Gerada automaticamente na primeira execucao do sincronizador do artigo 0002
# (formato: sk-sua-chave-gerada-localmente).
ANTHROPIC_API_KEY=coloque_aqui_sua_chave_do_9router

# Combo Padrao Ativo para Claude Code (Nomes de combo NUNCA devem ter barra)
# Cada papel aponta para um modelo individual, o que torna o consumo previsivel.
# Os combos ficam disponiveis no modelPicker e via --model, para quando a cota
# de uma familia estourar.
# Nao use arsenal-offline aqui: o modelo local responde ao gateway, mas nao
# segue instrucoes no harness, e as tarefas do papel falhariam silenciosamente.
ANTHROPIC_MODEL=ag/gemini-3.8-flash-high
ANTHROPIC_DEFAULT_FABLE_MODEL=ag/gemini-pro-agent
ANTHROPIC_DEFAULT_OPUS_MODEL=ag/gemini-3.8-flash-high
ANTHROPIC_DEFAULT_SONNET_MODEL=ag/gemini-3.7-flash-high
ANTHROPIC_DEFAULT_HAIKU_MODEL=ag/gemini-3.6-flash-high

# Chaves de Provedores Gratuitos
# Google AI Studio: no catalogo do gateway os identificadores sao
# gemini/gemini-3.8-flash, 3.7-flash, 3.6-flash, 3.5-flash-lite e 3.1-pro-preview
GEMINI_API_KEY=coloque_aqui_sua_chave_do_google_ai_studio

# Groq Cloud (inferencia acelerada por LPU; validamos o openai/gpt-oss-120b)
GROQ_API_KEY=coloque_aqui_sua_chave_do_groq_cloud

# OpenRouter Free Tier (catalogo :free muda com frequencia; valide com src/test_arsenal.py)
OPENROUTER_API_KEY=coloque_aqui_sua_chave_do_openrouter

# Ollama Local: ultimo nivel da cascata, sem custo e sem depender de internet.
# Garante que o combo sempre devolva resposta; nao conduz uma sessao de trabalho.
OLLAMA_API_KEY=coloque_aqui_sua_chave_do_ollama
OLLAMA_BASE_URL=http://localhost:11434

# Cerebras Cloud (opcional, NAO usado pelos combos de referencia deste artigo)
CEREBRAS_API_KEY=coloque_aqui_sua_chave_da_cerebras

# Mistral AI (Codestral entra na cascata do arsenal-supremo e do arsenal-rapido)
# Gere a chave no console em https://console.mistral.ai/
MISTRAL_API_KEY=coloque_aqui_sua_chave_da_mistral

# Flags Avancadas de Autonomia do Claude Code
CLAUDE_CODE_EXPERIMENTAL=1
CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1
