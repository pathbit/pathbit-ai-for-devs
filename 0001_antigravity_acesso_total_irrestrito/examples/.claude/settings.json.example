{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "NotebookEdit(*)",
      "TodoWrite(*)",
      "Agent(*)",
      "Skill(*)"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL": "1",
    "CLAUDE_CODE_ENABLE_LOOPS": "1",
    "CLAUDE_CODE_ENABLE_ADVISOR": "1",
    "CLAUDE_CODE_ENABLE_GOAL": "1"
  },
  "includeCoAuthoredBy": false
}