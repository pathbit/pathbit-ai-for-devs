# ==============================================================================
# ClaudeGravity (9Router e Claude Code - Configuracao de Ambiente)
# ==============================================================================

# Servidor 9Router
PORT=20128
HOSTNAME=0.0.0.0
NODE_ENV=production
DATA_DIR=/app/data
NEXT_PUBLIC_BASE_URL=http://localhost:20128

# Seguranca e Acesso ao Dashboard
# Obrigatorias: o docker-compose.yml interrompe a subida se estiverem ausentes.
# Defina uma senha propria. Gere uma com: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
INITIAL_PASSWORD=coloque_aqui_sua_senha
JWT_SECRET=coloque_aqui_um_segredo_longo_e_aleatorio
REQUIRE_API_KEY=false
REQUIRE_LOGIN=false

# Integracao com Claude Code (Aponte para o gateway local na porta 20128)
ANTHROPIC_BASE_URL=http://localhost:20128
# Gerada automaticamente na primeira execucao de src/sync_antigravity_token.py
# (formato: sk-sua-chave-gerada-localmente).
ANTHROPIC_API_KEY=coloque_aqui_sua_chave_do_9router

# Flags Avancadas de Autonomia do Claude Code
CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1

# Painel do 9RTKSync (porta 9190)
# Obrigatoria: o docker-compose.yml interrompe a subida se estiver ausente.
# Sem ela o painel responde 401 e nao ha senha para informar.
# Gere uma com: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=coloque_aqui_a_senha_do_painel
