# ==============================================================================
# Pathbit AI for Devs - Configuracao Global de Ambiente
# ==============================================================================
# Este repositorio contem modulos e artigos para orquestracao de IA.
# Para cada modulo ou demonstracao:
#   1. Copie o .env.example correspondente para .env:
#      - No modulo 0002: cp 0002_claude_gravity_utilizando_9router/.env.example 0002_claude_gravity_utilizando_9router/.env
#      - No modulo 0003: cp 0003_fallback_modelos_gratuitos_9router/.env.example 0003_fallback_modelos_gratuitos_9router/.env
#   2. Preencha suas senhas locais e chaves gratuitas de provedores (Groq, Gemini, OpenRouter)
#   3. O arquivo .env e estritamente ignorado pelo controle de versao (.gitignore)
# ==============================================================================

# Seguranca e Gateway Local (9Router / OmniRoute)
PORT=20128
HOSTNAME=0.0.0.0
NODE_ENV=production
DATA_DIR=/app/data
NEXT_PUBLIC_BASE_URL=http://localhost:20128

# Credenciais de acesso local
INITIAL_PASSWORD=coloque_aqui_sua_senha
JWT_SECRET=coloque_aqui_seu_jwt_secret
REQUIRE_API_KEY=false
REQUIRE_LOGIN=false

# Claude Code CLI
ANTHROPIC_BASE_URL=http://localhost:20128
ANTHROPIC_API_KEY=coloque_aqui_sua_chave_do_9router
CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1

# Guardiao de Conexoes router-sync (9RTKSync / OminiRTKSync)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=pathbit
SYNC_INTERVAL=300
REFRESH_MARGIN=900
