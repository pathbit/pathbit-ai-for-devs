        <mxCell id="t_bg" value="FLUXO SDD: GOVERNANÇA, PLAN MODE E VALIDAÇÃO CRUZADA DE SUBAGENTES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141921;strokeColor=#7C3AED;strokeWidth=1;fontColor=#C3B6FD;fontFamily=Helvetica;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="b_spec" value="&lt;b&gt;📋 1. SPEC CANÔNICA&lt;/b&gt;&lt;br&gt;&lt;font color='#94A3B8'&gt;specs/01-feed-artigos.md&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;O Quê:&lt;/b&gt; Propósito conciso&lt;br&gt;• &lt;b&gt;Por Quê:&lt;/b&gt; Valor para negócio&lt;br&gt;• &lt;b&gt;Req. Funcionais:&lt;/b&gt; API e UX&lt;br&gt;• &lt;b&gt;Req. Não-Funcionais:&lt;/b&gt; &amp;lt; 50ms&lt;br&gt;• &lt;b&gt;Escopo &amp;amp; Fora de Escopo&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Restrições:&lt;/b&gt; SQLite WAL&lt;br&gt;• &lt;b&gt;Critérios Aceite:&lt;/b&gt; Matriz binária" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E2638;strokeColor=#38BDF8;strokeWidth=2;fontColor=#E2E8F0;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="250" height="240" as="geometry" />
        </mxCell>

        <mxCell id="b_arq" value="&lt;b&gt;🧠 2. AGENTE ARQUITETO&lt;/b&gt;&lt;br&gt;&lt;font color='#C3B6FD'&gt;Plan Mode (Shift+Tab)&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Consulta &lt;b&gt;specs/roadmap.md&lt;/b&gt;&lt;br&gt;• Lê memória viva (&lt;b&gt;CLAUDE.md&lt;/b&gt;)&lt;br&gt;• Desenha plano em 6 disciplinas&lt;br&gt;• &lt;b&gt;ZERO escrita em disco&lt;/b&gt;&lt;br&gt;• Mapeia arquivos e contratos&lt;br&gt;&lt;br&gt;&lt;font color='#00B050'&gt;&lt;b&gt;Aprovação Humana com Enter&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E2638;strokeColor=#7C3AED;strokeWidth=2;fontColor=#E2E8F0;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="100" width="250" height="240" as="geometry" />
        </mxCell>

        <mxCell id="b_imp" value="&lt;b&gt;⚡ 3. AGENTE IMPLEMENTADOR&lt;/b&gt;&lt;br&gt;&lt;font color='#FBBF24'&gt;Construção Cirúrgica&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Executa &lt;b&gt;/implementar-spec&lt;/b&gt;&lt;br&gt;• DB: &lt;b&gt;data/noticias.db&lt;/b&gt; WAL&lt;br&gt;• API: &lt;b&gt;src/routes/feedRoutes.js&lt;/b&gt;&lt;br&gt;• Design &amp;amp; SPA: &lt;b&gt;public/&lt;/b&gt; Tokens&lt;br&gt;• DevOps: &lt;b&gt;Dockerfile Multi-Stage&lt;/b&gt;&lt;br&gt;• Testes: &lt;b&gt;tests/artigos.test.js&lt;/b&gt;&lt;br&gt;• Código desacoplado e enxuto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E2638;strokeColor=#FBBF24;strokeWidth=2;fontColor=#E2E8F0;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="100" width="250" height="240" as="geometry" />
        </mxCell>

        <mxCell id="b_audit" value="&lt;b&gt;🛡️ 4. SUBAGENTE AUDITOR&lt;/b&gt;&lt;br&gt;&lt;font color='#34D399'&gt;Cross-Validation Isolada&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Janela de contexto &lt;b&gt;100% virgem&lt;/b&gt;&lt;br&gt;• Zero viés de confirmação&lt;br&gt;• Audita git diff vs Critérios&lt;br&gt;• Executa &lt;b&gt;npm test&lt;/b&gt; (7/7 suites)&lt;br&gt;• Valida não-funcionais (&amp;lt; 50ms)&lt;br&gt;&lt;br&gt;&lt;font color='#34D399'&gt;&lt;b&gt;PARECER: APROVADO ✅&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E2638;strokeColor=#34D399;strokeWidth=2;fontColor=#E2E8F0;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="910" y="100" width="250" height="240" as="geometry" />
